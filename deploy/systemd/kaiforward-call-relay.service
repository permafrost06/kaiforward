[Unit]
Description=KaiForward local browser call relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/frost/work/kaiforward/poc
ExecStart=/usr/bin/python3 /home/frost/work/kaiforward/poc/server/call_relay.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
